import { <%= resourceCamel %>Repository } from "./<%= resourceKebab %>.repository";
import type { <%= entityPascal %><% if (crud) { %>, Create<%= entityPascal %>Input, Update<%= entityPascal %>Input<% } %> } from "./<%= resourceKebab %>.types";

export const <%= resourceCamel %>Service = {
<% if (crud) { -%>
  list(): <%= entityPascal %>[] {
    return <%= resourceCamel %>Repository.findAll();
  },

  getById(id: string): <%= entityPascal %> | undefined {
    return <%= resourceCamel %>Repository.findById(id);
  },

  create(input: Create<%= entityPascal %>Input): <%= entityPascal %> {
    return <%= resourceCamel %>Repository.create(input);
  },

  update(id: string, input: Update<%= entityPascal %>Input): <%= entityPascal %> | undefined {
    return <%= resourceCamel %>Repository.update(id, input);
  },

  remove(id: string): boolean {
    return <%= resourceCamel %>Repository.delete(id);
  },
<% } else { -%>
  status(): string {
    return <%= resourceCamel %>Repository.ping();
  },
<% } -%>
};
