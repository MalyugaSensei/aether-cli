export type <%= it.entityPascal %> = {
  id: string;
<% if (it.crud) { it.fields.forEach(function(field) { %>
  <%= field.name %>: <%= field.tsType %>;
<% }); } %>
};

<% if (it.crud) { %>
export type Create<%= it.entityPascal %>Input = Omit<<%= it.entityPascal %>, "id">;

export type Update<%= it.entityPascal %>Input = Partial<Omit<<%= it.entityPascal %>, "id">>;
<% } %>
