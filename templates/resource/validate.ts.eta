import type { Create<%= it.entityPascal %>Input, Update<%= it.entityPascal %>Input } from "./<%= it.resourceKebab %>.types";

/** Replace this module with Zod/Ajv/etc. when you outgrow hand-rolled checks. */
export type ValidateResult<T> = { ok: true; value: T } | { ok: false; message: string };

export function parseCreateInput(body: unknown): ValidateResult<Create<%= it.entityPascal %>Input> {
  if (typeof body !== "object" || body === null) {
    return { ok: false, message: "Invalid request body" };
  }
  const b = body as Record<string, unknown>;
<% if (it.fields.length === 0) { %>
  for (const key of Object.keys(b)) {
    return { ok: false, message: "Invalid request body" };
  }
  return { ok: true, value: {} as Create<%= it.entityPascal %>Input };
<% } else { %>
<% it.fields.filter(function(f) { return f.required; }).forEach(function(field) { %>
  if (typeof b.<%= field.name %> !== "<%= field.tsType %>") {
    return { ok: false, message: "Invalid request body" };
  }
<% if (field.tsType === "string") { %>
  if ((b.<%= field.name %> as string).length === 0) {
    return { ok: false, message: "Invalid request body" };
  }
<% } %>
<% }); %>
  return {
    ok: true,
    value: b as Create<%= it.entityPascal %>Input,
  };
<% } %>
}

export function parseUpdateInput(body: unknown): ValidateResult<Update<%= it.entityPascal %>Input> {
  if (typeof body !== "object" || body === null) {
    return { ok: false, message: "Invalid request body" };
  }
<% if (it.fields.length === 0) { %>
  return { ok: false, message: "No update fields configured" };
<% } else { %>
  const b = body as Record<string, unknown>;
  let hasField = false;
<% it.fields.forEach(function(field) { %>
  if (b.<%= field.name %> !== undefined) {
    hasField = true;
    if (typeof b.<%= field.name %> !== "<%= field.tsType %>") {
      return { ok: false, message: "Invalid request body" };
    }
<% if (field.tsType === "string") { %>
    if ((b.<%= field.name %> as string).length === 0) {
      return { ok: false, message: "Invalid request body" };
    }
<% } %>
  }
<% }); %>
  if (!hasField) {
    return { ok: false, message: "Invalid request body" };
  }
  return {
    ok: true,
    value: b as Update<%= it.entityPascal %>Input,
  };
<% } %>
}
