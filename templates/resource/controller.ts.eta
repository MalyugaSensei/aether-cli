import type { IncomingMessage, ServerResponse } from "node:http";
import type { Params } from "../app/router";
import { JsonBodyError, readJson, sendError, sendJson, HTTP_STATUS } from "../app/http";
import type { <%= it.entityPascal %>Service } from "./<%= it.resourceKebab %>.service";
<% if (it.crud) { %>
import { parseCreateInput, parseUpdateInput } from "./<%= it.resourceKebab %>.validate";
import { parseListQuery } from "../app/list";
<% } %>

const REPOSITORY_NOT_CONFIGURED = "Repository not configured";

<% if (it.crud) { %>
async function parseJson(req: IncomingMessage): Promise<unknown> {
  try {
    return await readJson(req);
  } catch (err) {
    if (err instanceof JsonBodyError) {
      throw err;
    }
    throw new JsonBodyError("Invalid JSON body");
  }
}

export function create<%= it.entityPascal %>Controller(deps: {
  service: <%= it.entityPascal %>Service | null;
  repositoryConfigured: boolean;
}) {
  return {
    async list(req: IncomingMessage, res: ServerResponse, _params: Params): Promise<void> {
      const url = new URL(req.url ?? "/", "http://localhost");
      const parsed = parseListQuery(url.searchParams);
      if (!parsed.ok) {
        sendError(res, HTTP_STATUS.BAD_REQUEST, parsed.message);
        return;
      }
      if (!deps.repositoryConfigured || !deps.service) {
        sendError(res, HTTP_STATUS.NOT_IMPLEMENTED, REPOSITORY_NOT_CONFIGURED);
        return;
      }
      sendJson(res, HTTP_STATUS.OK, deps.service.list(parsed.value));
    },

    async getById(_req: IncomingMessage, res: ServerResponse, params: Params): Promise<void> {
      if (!deps.repositoryConfigured || !deps.service) {
        sendError(res, HTTP_STATUS.NOT_IMPLEMENTED, REPOSITORY_NOT_CONFIGURED);
        return;
      }
      const item = deps.service.getById(params.id!);
      if (!item) {
        sendError(res, HTTP_STATUS.NOT_FOUND, "Not found");
        return;
      }
      sendJson(res, HTTP_STATUS.OK, item);
    },

    async create(req: IncomingMessage, res: ServerResponse, _params: Params): Promise<void> {
      if (!deps.repositoryConfigured || !deps.service) {
        sendError(res, HTTP_STATUS.NOT_IMPLEMENTED, REPOSITORY_NOT_CONFIGURED);
        return;
      }
      let body: unknown;
      try {
        body = await parseJson(req);
      } catch (err) {
        if (err instanceof JsonBodyError) {
          sendError(res, err.status, err.message);
          return;
        }
        throw err;
      }
      const parsed = parseCreateInput(body);
      if (!parsed.ok) {
        sendError(res, HTTP_STATUS.BAD_REQUEST, parsed.message);
        return;
      }
      const created = deps.service.create(parsed.value);
      sendJson(res, HTTP_STATUS.CREATED, created);
    },

    async update(req: IncomingMessage, res: ServerResponse, params: Params): Promise<void> {
      if (!deps.repositoryConfigured || !deps.service) {
        sendError(res, HTTP_STATUS.NOT_IMPLEMENTED, REPOSITORY_NOT_CONFIGURED);
        return;
      }
      let body: unknown;
      try {
        body = await parseJson(req);
      } catch (err) {
        if (err instanceof JsonBodyError) {
          sendError(res, err.status, err.message);
          return;
        }
        throw err;
      }
      const parsed = parseUpdateInput(body);
      if (!parsed.ok) {
        sendError(res, HTTP_STATUS.BAD_REQUEST, parsed.message);
        return;
      }
      const updated = deps.service.update(params.id!, parsed.value);
      if (!updated) {
        sendError(res, HTTP_STATUS.NOT_FOUND, "Not found");
        return;
      }
      sendJson(res, HTTP_STATUS.OK, updated);
    },

    async remove(_req: IncomingMessage, res: ServerResponse, params: Params): Promise<void> {
      if (!deps.repositoryConfigured || !deps.service) {
        sendError(res, HTTP_STATUS.NOT_IMPLEMENTED, REPOSITORY_NOT_CONFIGURED);
        return;
      }
      const ok = deps.service.remove(params.id!);
      if (!ok) {
        sendError(res, HTTP_STATUS.NOT_FOUND, "Not found");
        return;
      }
      res.statusCode = HTTP_STATUS.NO_CONTENT;
      res.end();
    },
  };
}

export type <%= it.entityPascal %>Controller = ReturnType<typeof create<%= it.entityPascal %>Controller>;
<% } else { %>
export function create<%= it.entityPascal %>Controller(deps: { service: <%= it.entityPascal %>Service }) {
  return {
    async status(_req: IncomingMessage, res: ServerResponse, _params: Params): Promise<void> {
      sendJson(res, HTTP_STATUS.OK, { resource: deps.service.status() });
    },
  };
}

export type <%= it.entityPascal %>Controller = ReturnType<typeof create<%= it.entityPascal %>Controller>;
<% } %>
