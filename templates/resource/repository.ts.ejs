import { randomUUID } from "node:crypto";
import type { <%= entityPascal %><% if (crud) { %>, Create<%= entityPascal %>Input, Update<%= entityPascal %>Input<% } %> } from "./<%= resourceKebab %>.types";

// In-memory store — replace with a real database adapter.
const store = new Map<string, <%= entityPascal %>>();

export const <%= resourceCamel %>Repository = {
<% if (crud) { -%>
  findAll(): <%= entityPascal %>[] {
    return [...store.values()];
  },

  findById(id: string): <%= entityPascal %> | undefined {
    return store.get(id);
  },

  create(input: Create<%= entityPascal %>Input): <%= entityPascal %> {
    const entity: <%= entityPascal %> = {
      id: randomUUID(),
      name: input.name,
    };
    store.set(entity.id, entity);
    return entity;
  },

  update(id: string, input: Update<%= entityPascal %>Input): <%= entityPascal %> | undefined {
    const existing = store.get(id);
    if (!existing) return undefined;
    const updated: <%= entityPascal %> = {
      ...existing,
      ...input,
    };
    store.set(id, updated);
    return updated;
  },

  delete(id: string): boolean {
    return store.delete(id);
  },
<% } else { -%>
  // TODO: add persistence methods
  ping(): string {
    return "<%= resourceKebab %>";
  },
<% } -%>
};
