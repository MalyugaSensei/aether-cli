<% if (it.crud) { %>
import type { <%= it.entityPascal %>Repository } from "./<%= it.resourceKebab %>.repository";
import type {
  <%= it.entityPascal %>,
  Create<%= it.entityPascal %>Input,
  Update<%= it.entityPascal %>Input,
} from "./<%= it.resourceKebab %>.types";
import type { ListQuery } from "../app/list";

export function create<%= it.entityPascal %>Service(repository: <%= it.entityPascal %>Repository) {
  return {
    list(query: ListQuery): <%= it.entityPascal %>[] {
      return repository.findAll(query);
    },

    getById(id: string): <%= it.entityPascal %> | undefined {
      return repository.findById(id);
    },

    create(input: Create<%= it.entityPascal %>Input): <%= it.entityPascal %> {
      return repository.create(input);
    },

    update(id: string, input: Update<%= it.entityPascal %>Input): <%= it.entityPascal %> | undefined {
      return repository.update(id, input);
    },

    remove(id: string): boolean {
      return repository.delete(id);
    },
  };
}

export type <%= it.entityPascal %>Service = ReturnType<typeof create<%= it.entityPascal %>Service>;
<% } else { %>
export function create<%= it.entityPascal %>Service() {
  return {
    status(): string {
      return "<%= it.resourceKebab %>";
    },
  };
}

export type <%= it.entityPascal %>Service = ReturnType<typeof create<%= it.entityPascal %>Service>;
<% } %>
