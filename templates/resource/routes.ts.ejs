import type { Route } from "../app/router";
import { <%= resourceCamel %>Controller } from "./<%= resourceKebab %>.controller";

export const <%= resourceCamel %>Routes: Route[] = [
<% if (crud) { -%>
  { method: "GET", path: "/<%= resourceKebab %>", handler: <%= resourceCamel %>Controller.list },
  { method: "GET", path: "/<%= resourceKebab %>/:id", handler: <%= resourceCamel %>Controller.getById },
  { method: "POST", path: "/<%= resourceKebab %>", handler: <%= resourceCamel %>Controller.create },
  { method: "PATCH", path: "/<%= resourceKebab %>/:id", handler: <%= resourceCamel %>Controller.update },
  { method: "DELETE", path: "/<%= resourceKebab %>/:id", handler: <%= resourceCamel %>Controller.remove },
<% } else { -%>
  { method: "GET", path: "/<%= resourceKebab %>", handler: <%= resourceCamel %>Controller.status },
<% } -%>
];
