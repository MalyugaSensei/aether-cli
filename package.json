{
  "name": "chisel-js",
  "version": "0.1.0",
  "description": "CLI for scaffolding Node.js HTTP backends in TypeScript",
  "keywords": [
    "cli",
    "scaffold",
    "generator",
    "nodejs",
    "typescript",
    "http",
    "backend"
  ],
  "license": "MIT",
  "author": "MalyugaSensei",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MalyugaSensei/chisel-js.git"
  },
  "bugs": {
    "url": "https://github.com/MalyugaSensei/chisel-js/issues"
  },
  "homepage": "https://github.com/MalyugaSensei/chisel-js#readme",
  "type": "module",
  "bin": {
    "chisel": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc && node scripts/copy-templates.mjs",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run tests/integration/e2e-install.test.ts",
    "prepublishOnly": "npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "eta": "^4.6.0",
    "prettier": "^3.9.7",
    "ts-morph": "^28.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
