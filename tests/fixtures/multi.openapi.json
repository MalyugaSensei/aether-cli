              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": { "name": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "/users/{id}": {
      "patch": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "name": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["total"],
                "properties": { "total": { "type": "number" } }
              }
            }
          }
        }
      }
    },
    "/orders/{id}": {
      "delete": {}
    }
  }
