{
  "openapi": "3.0.3",
  "info": { "title": "Ref", "version": "1.0.0" },
  "components": {
    "schemas": {
      "UserCreate": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string", "enum": ["admin", "member"] }
        }
      }
    }
  },
  "paths": {
    "/users": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserCreate" }
            }
          }
        }
      }
    },
    "/users/{id}": {
      "patch": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserCreate" }
            }
          }
        }
      }
    }
  }
}
